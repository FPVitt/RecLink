# Common defaults for both targets. Target-specific overrides live in
# sdkconfig.defaults.esp32c3 / sdkconfig.defaults.esp32s3 and are applied on top
# by idf.py based on the selected target.

# --- Partition table ---------------------------------------------------------
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- App / OTA -------------------------------------------------------------
CONFIG_APP_PROJECT_VER_FROM_CONFIG=n
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# --- FreeRTOS: deterministic memory (spec 1.2.6 / 12.1) --------------------
CONFIG_FREERTOS_SUPPORT_STATIC_ALLOCATION=y
CONFIG_FREERTOS_HZ=1000

# --- Task Watchdog (spec 3.5): 4 s, panic on timeout ----------------------
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=4
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n

# --- Brown-out detector (spec 2.2): enabled, default trip, reset ----------
CONFIG_ESP_BROWNOUT_DET=y
CONFIG_ESP_BROWNOUT_DET_LVL_SEL_7=y

# --- Bluetooth: NimBLE, central role, persistent bonds (spec 3.1 / 11.0) --
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_BONDS=4
CONFIG_BT_NIMBLE_MAX_CCCDS=20
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_SECURITY_ENABLE=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=4096
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
# cam_task owns reconnection (its own backoff + one-corrective-action discipline,
# spec 5.2 / 8.1). NimBLE's built-in blind connect-reattempt runs a *second*
# reconnect loop that races ours: it silently re-issues a failed connect up to N
# times before delivering the failure event, so our 10 s connect timeout fires
# mid-reattempt, a transient reattempt success triggers an MTU exchange on a
# dead handle (BLE_ERR_UNK_CONN_ID), and pairing gets killed in flight
# ("bond failed"). Disable it -- one owner per resource.
CONFIG_BT_NIMBLE_ENABLE_CONN_REATTEMPT=n

# --- Wi-Fi: AP only. 8 static RX buffers (1.6 KB each, taken from the heap at
#     Wi-Fi init), same as the gopro_ble_debug image whose OTA upload works; 12
#     cost 6 KB of a ~35 KB heap that the portal needs for page loads.
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=24
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_RX_BA_WIN=12
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y

# --- lwIP: a real TCP RECEIVE window + queue for OTA uploads -------------
# The SEND buffer is deliberately small (4 x MSS). Every connection that has just
# been sent a page asset keeps up to SND_BUF bytes of heap queued until the phone
# ACKs; at 20 KB, a page refresh (app.js.gz ~20 KB + the JSON built right after)
# exhausted the ~35 KB heap and the board stopped answering. The portal only ever
# sends small responses, so a small buffer costs nothing but a few round trips.
CONFIG_LWIP_TCP_WND_DEFAULT=20480
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=5744
CONFIG_LWIP_TCP_RECVMBOX_SIZE=16
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=32
CONFIG_LWIP_TCP_MSS=1436

# --- HTTP server --------------------------------------------------------
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=256

# --- NVS -------------------------------------------------------------------
CONFIG_NVS_ASSERT_ERROR_CHECK=n

# --- Logging: ring-buffer friendly, no colour ---------------------------
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_COLORS=n
CONFIG_LOG_TIMESTAMP_SOURCE_RTOS=y

# --- Coexistence (bench only; disabled in flight by esp_wifi_stop) -------
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# --- Panic behaviour: reboot, keep a summary in RTC for /api/status -----
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
CONFIG_ESP_DEBUG_STUBS_ENABLE=n
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_WARN_WRITE_STRINGS=y
