# ESP32-C3 -- production target. Single RISC-V core; all tasks share core 0 and
# rely on the priority scheme in spec 3.3. 400 KB SRAM: keep the memory budget
# honest here (this is the config a bare `idf.py build` compiles).
CONFIG_IDF_TARGET="esp32c3"
CONFIG_FREERTOS_UNICORE=y
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU0=y

# Single USB-Serial-JTAG for flash + console + debug.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# NimBLE host runs on core 0 (only core). Lower stack watermark headroom, so
# keep the stack as configured and measure.
CONFIG_BT_NIMBLE_PINNED_TO_CORE_0=y

# C3 flash is commonly 4 MB, 80 MHz QIO.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# --- Board: ESP32-C3 SuperMini -------------------------------------------
# FC MSP UART on GPIO6 (TX -> FC RX) / GPIO7 (RX <- FC TX). UART1 via GPIO matrix.
CONFIG_BRIDGE_UART_PORT=1
CONFIG_BRIDGE_UART_TX_GPIO=6
CONFIG_BRIDGE_UART_RX_GPIO=7
# BOOT button on GPIO9 (active-low) -- Kconfig default, kept explicit.
CONFIG_BRIDGE_BUTTON_GPIO=9
CONFIG_BRIDGE_BUTTON_ACTIVE_LOW=y
# Onboard blue LED: plain GPIO8, active-low (no WS2812 on the SuperMini).
CONFIG_BRIDGE_LED_GPIO=y
CONFIG_BRIDGE_LED_GPIO_NUM=8
CONFIG_BRIDGE_LED_ACTIVE_LOW=y
